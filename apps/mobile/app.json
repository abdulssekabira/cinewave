{
  "expo": {
    "name": "GLE Movies",
    "slug": "gle-movies",
    "scheme": "glemovies",
    "version": "1.2.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.gamersloft.glemovies",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b0d"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0d"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#0b0b0d",
    "owner": "arafatprimes-team",
    "extra": {
      "eas": {
        "projectId": "fbb90d1f-4899-4f7e-ae27-f38acf40a822"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fbb90d1f-4899-4f7e-ae27-f38acf40a822",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
